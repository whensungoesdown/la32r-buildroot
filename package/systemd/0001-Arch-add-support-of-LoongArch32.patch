From f408b75ecc58371373e38409aa3275540fa97c5a Mon Sep 17 00:00:00 2001
From: Jinyang Shen <shenjinyang@loongson.cn>
Date: Wed, 19 Apr 2023 14:20:45 +0800
Subject: [PATCH] Arch: add support of LoongArch32

Signed-off-by: Jinyang Shen <shenjinyang@loongson.cn>
---
 src/basic/architecture.c | 4 ++++
 src/basic/architecture.h | 8 ++++++++
 2 files changed, 12 insertions(+)

diff --git a/src/basic/architecture.c b/src/basic/architecture.c
index 773ee3c508..d731cbb8e1 100644
--- a/src/basic/architecture.c
+++ b/src/basic/architecture.c
@@ -73,6 +73,9 @@ Architecture uname_architecture(void) {
 #elif defined(__loongarch64)
                 { "loongarch64", ARCHITECTURE_LOONGARCH64 },
 
+#elif defined(__loongarch32)
+                { "loongarch32", ARCHITECTURE_LOONGARCH32 },
+
 #elif defined(__m68k__)
                 { "m68k",       ARCHITECTURE_M68K     },
 
@@ -152,6 +155,7 @@ static const char *const architecture_table[_ARCHITECTURE_MAX] = {
         [ARCHITECTURE_X86]         = "x86",
         [ARCHITECTURE_IA64]        = "ia64",
         [ARCHITECTURE_LOONGARCH64] = "loongarch64",
+        [ARCHITECTURE_LOONGARCH32] = "loongarch32",
         [ARCHITECTURE_M68K]        = "m68k",
         [ARCHITECTURE_MIPS64_LE]   = "mips64-le",
         [ARCHITECTURE_MIPS64]      = "mips64",
diff --git a/src/basic/architecture.h b/src/basic/architecture.h
index b86f5f35d0..479a90bccb 100644
--- a/src/basic/architecture.h
+++ b/src/basic/architecture.h
@@ -21,6 +21,7 @@ typedef enum {
         ARCHITECTURE_CRIS,
         ARCHITECTURE_IA64,
         ARCHITECTURE_LOONGARCH64,
+        ARCHITECTURE_LOONGARCH32,
         ARCHITECTURE_M68K,
         ARCHITECTURE_MIPS,
         ARCHITECTURE_MIPS64,
@@ -209,6 +210,13 @@ Architecture uname_architecture(void);
 #  else
 #    error "Unrecognized loongarch architecture variant"
 #  endif
+#elif defined(__loongarch32)
+#  define native_architecture() ARCHITECTURE_LOONGARCH32
+#  if defined(__loongarch_double_float)
+#    define LIB_ARCH_TUPLE "loongarch64-linux-gnuf64"
+#  else
+#    error "Unrecognized loongarch architecture variant"
+#  endif
 #elif defined(__m68k__)
 #  define native_architecture() ARCHITECTURE_M68K
 #  define LIB_ARCH_TUPLE "m68k-linux-gnu"
-- 
2.31.1

